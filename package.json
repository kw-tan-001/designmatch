{
  "name": "designmatch",
  "version": "1.0.0",
  "description": "DesignMatch - Interior Design Matching Platform (CSIT314 group project, BCE architecture)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node scripts/generate_test_data.js",
    "db:reset": "node db/migrate.js --reset && node scripts/generate_test_data.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "node scripts/check_syntax.js",
    "verify:stories": "node scripts/verify_stories.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
