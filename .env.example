# Copy to .env and adjust. Never commit the real .env file.
PORT=3000
NODE_ENV=development

# Main database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/designmatch
# Separate database used by `npm test` (it is wiped and re-migrated on every run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/designmatch_test

# Use a long random string in any shared or deployed environment
SESSION_SECRET=change-me-to-a-long-random-string

# Timezone used for daily/weekly/monthly report boundaries
APP_TIMEZONE=Asia/Singapore

# Set to true when served behind HTTPS (e.g. Render/Railway)
COOKIE_SECURE=false
